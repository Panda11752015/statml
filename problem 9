# axs[1].scatter(X2[:, 0], X2[:, 1], c=spectral2.labels_, s=10)
# axs[2].scatter(X3[:, 0], X3[:, 1], c=spectral3.labels_, s=10)

axs[0].scatter(X1[:, 0], X1[:, 1], c=meanshift1.labels_, s=10)
axs[1].scatter(X2[:, 0], X2[:, 1], c=meanshift2.labels_, s=10)
axs[2].scatter(X3[:, 0], X3[:, 1], c=meanshift3.labels_, s=10)
  

